DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_app?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Local dev base URL (e.g. http://localhost:3000)
AUTH_URL="http://localhost:3000"

# Datadog / local observability (host Next.js → Agent on localhost:8126)
DD_SERVICE="hotel-booking-local"
DD_ENV="local"
DD_TRACE_AGENT_URL="http://127.0.0.1:8126"
# Correlate pino/std logs with traces when exporting to Datadog
DD_TRACE_LOGS_INJECTION="true"
